{
  "name": "push-all-in-cloud",
  "version": "2.6.2",
  "description": "基于 push-all-in-one 和 hono 开发的云函数推送服务。支持 nodejs/docker/vercel 等部署方式",
  "author": "CaoMeiYouRen",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "scripts": {
    "lint": "cross-env NODE_ENV=production eslint src --fix --ext .ts,.js",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release",
    "build": "rimraf dist && tsup",
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false src/index.ts",
    "watch": "tsc -w",
    "start": "node ./dist/index.js",
    "commit": "cz",
    "prepare": "husky install",
    "test": "jest --config jest.config.ts",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "dev:vercel": "vercel dev",
    "deploy:vercel": "vercel",
    "dev:cloudflare": "wrangler dev"
  },
  "devDependencies": {
    "@cao-mei-you-ren/avue-types": "^1.1.0",
    "@types/debug": "^4.1.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "commitizen": "^4.3.1",
    "commitlint": "^21.2.4",
    "commitlint-config-cmyr": "1.0.1",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog-cmyr": "2.0.1",
    "debug": "^4.4.3",
    "eslint": "^10.13.0",
    "eslint-config-cmyr": "2.3.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.3",
    "semantic-release": "25.0.9",
    "semantic-release-cmyr-config": "^1.1.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vercel": "^65.5.0",
    "wrangler": "^4.151.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "axios": "^1.20.0",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "push-all-in-one": "4.7.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "keywords": [
    "push",
    "docker",
    "vercel",
    "hono",
    "nodejs",
    "notifications"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "homepage": "https://github.com/CaoMeiYouRen/push-all-in-cloud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaoMeiYouRen/push-all-in-cloud.git"
  },
  "bugs": {
    "url": "https://github.com/CaoMeiYouRen/push-all-in-cloud/issues"
  },
  "type": "module",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog-cmyr"
    }
  },
  "changelog": {
    "language": "zh"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "npm run lint",
      "git add"
    ]
  }
}
